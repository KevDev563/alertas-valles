<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Permite HTTP en desarrollo local (emulador, IP local, hotspot). Para producción usa HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
